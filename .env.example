# GEMINI_API_KEY: Server-side Gemini free-tier API key (never exposed to Android APK or browser).
# In AI Studio: configured via Settings > Secrets.
# In Cloudflare Workers: configured via `npx wrangler secret put GEMINI_API_KEY`.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# FIREBASE_PROJECT_ID: Firebase project ID used by the backend to verify RS256 Firebase ID tokens.
FIREBASE_PROJECT_ID="enduring-agent-dt8c4"

# GEMINI_MODEL: Free-tier Gemini text generation model (defaults to gemini-3.8-flash).
GEMINI_MODEL="gemini-3.8-flash"

# DAILY_QUOTA_LIMIT: Per-user daily generation limit in Asia/Karachi timezone.
DAILY_QUOTA_LIMIT="10"

# APP_URL: Hosted URL injected at runtime in AI Studio.
APP_URL="MY_APP_URL"
